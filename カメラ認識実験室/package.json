{
  "name": "014-camera-vision-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/prepare-assets.mjs --verify && vite build && node scripts/check-static-site.mjs",
    "check:static": "node scripts/check-static-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:menu": "node scripts/check-menu.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
